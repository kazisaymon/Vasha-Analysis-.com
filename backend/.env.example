# --- FREE setup (recommended for class projects) ---
# Free key: https://aistudio.google.com/apikey  (no credit card)
GEMINI_API_KEY=
# Optional: pick another free model from AI Studio if you hit the daily limit
# GEMINI_MODEL=gemini-flash-lite-latest
# Free key for voice input (Whisper): https://console.groq.com/keys
GROQ_API_KEY=

# --- Paid alternative ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Comma-separated frontend URLs allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
RATE_LIMIT_PER_MIN=30
